  <version>0.0.1</version>
  <description>Launches de sensores da frota Marsupial.</description>

  <maintainer email="voce@marsupial.com">Marsupial</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

