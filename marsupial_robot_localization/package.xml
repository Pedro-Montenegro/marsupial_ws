<?xml version="1.0"?>
<package format="3">
  <name>marsupial_robot_localization</name>
  <version>0.0.1</version>
  <description>Camada de localização da frota Marsupial.</description>

  <maintainer email="voce@marsupial.com">Marsupial</maintainer>
  <license>Apache-2.0</license>


  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>ament_index_python</depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
